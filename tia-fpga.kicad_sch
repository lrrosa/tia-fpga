				(size 1.30 1.30)
			)
			(justify left)
		)
		(uuid "8eb2035d-5128-40ca-ae87-9e1d6113f60d")
	)
	(text "1.8 V-powered buffer. Recovering those 8 pins is the rev B fix."
		(exclude_from_sim no)
		(at 20.00 145.50 0)
		(effects
			(font
				(size 1.30 1.30)
			)
			(justify left)
		)
		(uuid "a4468321-a433-4eb8-9b08-80883408c852")
	)
	(text "J4/18 (+5 V from the Tang Nano) left open on purpose: this board is fed"
		(exclude_from_sim no)
		(at 20.00 150.00 0)
		(effects
			(font
				(size 1.30 1.30)
			)
			(justify left)
		)
		(uuid "57a94db4-ae17-4706-b1c8-5371bbe37b91")
	)
	(text "from the breadboard rail, so tying both would put two sources on one net."
		(exclude_from_sim no)
		(at 20.00 153.50 0)
		(effects
