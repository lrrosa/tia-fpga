		)
		(uuid "65d374eb-5b2a-4ff5-9fc4-0fe36151b1e7")
	)
	(text "Of the 48 header pins only 29 are usable 3.3 V GPIO: 8 are BANK3 at 1.8 V,"
		(exclude_from_sim no)
		(at 20.00 39.50 0)
		(effects
