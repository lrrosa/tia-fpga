			)
			(justify left)
		)
		(uuid "effa71d8-d7a2-47a7-956d-0cd36fdba736")
	)
	(text "Of the 48 header pins only 29 are usable 3.3 V GPIO: 8 are BANK3 at 1.8 V,"
		(exclude_from_sim no)
		(at 20.00 39.50 0)
		(effects
			(font
				(size 1.40 1.40)
			)
			(justify left)
		)
		(uuid "43b77880-4aa9-47c5-8655-bcf63d045eee")
	)
	(text "8 are HDMI differential pairs, 3 are power. Rev A uses all 29, with none spare."
