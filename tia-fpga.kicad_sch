	(text "COLOUR VIDEO - via the Tang Nano's HDMI connector"
		(exclude_from_sim no)
		(at 228.00 105.00 0)
		(effects
			(font
				(size 1.60 1.60)
				(bold yes)
			)
			(justify left)
		)
		(uuid "d486eadd-1e98-4eff-8be9-1f18ece88542")
	)
	(text "The 7-bit colour value never leaves the FPGA: an internal"
		(exclude_from_sim no)
		(at 228.00 109.50 0)
		(effects
			(font
				(size 1.20 1.20)
			)
			(justify left)
		)
		(uuid "5b908bbf-f9e2-4612-b5df-fd2c93d56083")
	)
	(text "TMDS encoder drives the HDMI pins, which are dedicated"
		(exclude_from_sim no)
		(at 228.00 112.80 0)
		(effects
			(font
				(size 1.20 1.20)
			)
			(justify left)
		)
		(uuid "d15fa99a-0362-4e7c-831c-bc48a84a5806")
	)
	(text "differential pairs on the module and were never part of"
		(exclude_from_sim no)
		(at 228.00 116.10 0)
		(effects
			(font
				(size 1.20 1.20)
			)
			(justify left)
		)
		(uuid "1eb0853b-103d-48d1-91b1-1ab5d6d56d81")
	)
	(text "the 29-pin GPIO budget. Colour costs zero header pins."
		(exclude_from_sim no)
		(at 228.00 119.40 0)
		(effects
			(font
				(size 1.20 1.20)
			)
			(justify left)
		)
		(uuid "8a6011ab-0583-4747-adc4-ee24ea1f3b95")
	)
	(text "FPGA pins (P/N): CK 69/68, D0 71/70, D1 73/72, D2 75/74."
		(exclude_from_sim no)
		(at 228.00 123.50 0)
		(effects
