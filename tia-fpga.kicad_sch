		(uuid "f4de52e2-55e1-4139-a42b-4b73a39b40c8")
	)
	(text "Of the 48 header pins only 29 are usable 3.3 V GPIO: 8 are BANK3 at 1.8 V,"
		(exclude_from_sim no)
		(at 20.00 39.50 0)
		(effects
			(font
