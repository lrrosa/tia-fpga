		(uuid "dc64aa9c-f6b1-4712-a9a2-5f493a3a3eda")
	)
	(text "1.8 V-powered buffer. Recovering those 8 pins is the rev B fix."
		(exclude_from_sim no)
		(at 20.00 145.50 0)
		(effects
			(font
				(size 1.30 1.30)
			)
			(justify left)
		)
		(uuid "c6ad396a-0c6d-4835-accc-020b88f217e8")
	)
	(text "J4/18 (+5 V from the Tang Nano) left open on purpose: this board is fed"
		(exclude_from_sim no)
		(at 20.00 150.00 0)
		(effects
