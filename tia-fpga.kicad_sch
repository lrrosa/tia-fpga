	(text "COLOUR VIDEO - via the Tang Nano's HDMI connector"
		(exclude_from_sim no)
		(at 228.00 105.00 0)
		(effects
			(font
				(size 1.60 1.60)
				(bold yes)
			)
			(justify left)
		)
		(uuid "a0d26f80-9186-47d1-9886-4a22e7d9add1")
	)
	(text "The 7-bit colour value never leaves the FPGA: an internal"
		(exclude_from_sim no)
		(at 228.00 109.50 0)
		(effects
			(font
				(size 1.20 1.20)
			)
			(justify left)
		)
		(uuid "a4737a4c-7d62-423d-9db4-4ef2345165eb")
	)
	(text "TMDS encoder drives the HDMI pins, which are dedicated"
		(exclude_from_sim no)
		(at 228.00 112.80 0)
		(effects
			(font
				(size 1.20 1.20)
			)
			(justify left)
		)
		(uuid "11299752-dcdc-487e-83b0-b948b0d63b62")
	)
	(text "differential pairs on the module and were never part of"
		(exclude_from_sim no)
		(at 228.00 116.10 0)
		(effects
			(font
				(size 1.20 1.20)
			)
			(justify left)
		)
		(uuid "0dd37d90-20e8-46b9-a8a0-da9612986da0")
	)
	(text "the 29-pin GPIO budget. Colour costs zero header pins."
		(exclude_from_sim no)
		(at 228.00 119.40 0)
		(effects
			(font
				(size 1.20 1.20)
			)
			(justify left)
		)
		(uuid "33c706d7-1a07-4ccb-9d44-505eecc28b77")
	)
	(text "FPGA pins (P/N): CK 69/68, D0 71/70, D1 73/72, D2 75/74."
		(exclude_from_sim no)
		(at 228.00 123.50 0)
		(effects
			(font
				(size 1.20 1.20)
			)
			(justify left)
		)
		(uuid "8b903da4-c78e-4a8b-bea2-c7e822c34261")
	)
	(text "RULE: leave J1/23-24 and J4/12-17 open - they carry the"
		(exclude_from_sim no)
		(at 228.00 127.60 0)
		(effects
			(font
				(size 1.20 1.20)
			)
			(justify left)
		)
		(uuid "594b3aea-a6a3-47e1-81ec-bdffda70ce28")
	)
	(text "same TMDS pairs, and any stub degrades the signal."
