	(text "J4/2-9 are BANK3 at 1.8 V - unusable at 3.3 V without a local LDO and a"
		(exclude_from_sim no)
		(at 20.00 142.00 0)
		(effects
			(font
				(size 1.30 1.30)
			)
			(justify left)
		)
		(uuid "0538f16a-a1fc-4186-815e-c40e5b3bbf50")
	)
	(text "1.8 V-powered buffer. Recovering those 8 pins is the rev B fix."
		(exclude_from_sim no)
		(at 20.00 145.50 0)
		(effects
			(font
				(size 1.30 1.30)
			)
			(justify left)
		)
		(uuid "ad4b6757-d20d-463e-aeaf-cbd91a889724")
	)
	(text "J4/18 (+5 V from the Tang Nano) left open on purpose: this board is fed"
		(exclude_from_sim no)
		(at 20.00 150.00 0)
		(effects
			(font
				(size 1.30 1.30)
			)
			(justify left)
		)
		(uuid "aba426ba-489c-4fc8-a16c-d80cf2ef7d66")
	)
	(text "from the breadboard rail, so tying both would put two sources on one net."
		(exclude_from_sim no)
		(at 20.00 153.50 0)
		(effects
			(font
				(size 1.30 1.30)
			)
			(justify left)
		)
		(uuid "6bca3b71-94a4-4d3f-9d99-a6cac37f9201")
	)
	(text "Power the Tang Nano over USB. +3V3 is taken from J4/24."
		(exclude_from_sim no)
		(at 20.00 157.00 0)
		(effects
			(font
				(size 1.30 1.30)
			)
			(justify left)
		)
		(uuid "ed85631f-b50b-4287-b4ef-15f1de4f7e83")
	)
