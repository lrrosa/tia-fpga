	(text "COLOUR VIDEO - via the Tang Nano's HDMI connector"
		(exclude_from_sim no)
		(at 228.00 105.00 0)
		(effects
			(font
				(size 1.60 1.60)
				(bold yes)
			)
			(justify left)
		)
		(uuid "e77454b7-14df-4986-acf8-9e4937931bfb")
	)
	(text "The 7-bit colour value never leaves the FPGA: an internal"
		(exclude_from_sim no)
		(at 228.00 109.50 0)
		(effects
			(font
				(size 1.20 1.20)
			)
			(justify left)
		)
		(uuid "1560f13a-362d-4866-88fb-9563adec20c4")
	)
	(text "TMDS encoder drives the HDMI pins, which are dedicated"
		(exclude_from_sim no)
		(at 228.00 112.80 0)
		(effects
			(font
				(size 1.20 1.20)
			)
			(justify left)
		)
		(uuid "876465e8-0025-43e2-80d9-34728ed97d91")
	)
	(text "differential pairs on the module and were never part of"
		(exclude_from_sim no)
		(at 228.00 116.10 0)
		(effects
			(font
				(size 1.20 1.20)
			)
			(justify left)
		)
		(uuid "7f4665d9-b3ba-4afc-b405-d94a6c057e2e")
	)
	(text "the 29-pin GPIO budget. Colour costs zero header pins."
		(exclude_from_sim no)
		(at 228.00 119.40 0)
		(effects
			(font
				(size 1.20 1.20)
			)
			(justify left)
		)
		(uuid "ae896a46-93f0-495a-baa2-3c0e67a1f2f6")
	)
	(text "FPGA pins (P/N): CK 69/68, D0 71/70, D1 73/72, D2 75/74."
		(exclude_from_sim no)
		(at 228.00 123.50 0)
		(effects
			(font
				(size 1.20 1.20)
			)
			(justify left)
		)
		(uuid "5ae1b747-775d-42cf-a55f-21e72eeca9f1")
	)
	(text "RULE: leave J1/23-24 and J4/12-17 open - they carry the"
		(exclude_from_sim no)
		(at 228.00 127.60 0)
		(effects
			(font
				(size 1.20 1.20)
			)
			(justify left)
		)
		(uuid "45743b58-320f-4e2a-ad69-95f44ea0e056")
	)
	(text "same TMDS pairs, and any stub degrades the signal."
