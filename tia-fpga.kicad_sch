	(text "J4/2-9 are BANK3 at 1.8 V - unusable at 3.3 V without a local LDO and a"
		(exclude_from_sim no)
		(at 20.00 142.00 0)
		(effects
			(font
				(size 1.30 1.30)
			)
			(justify left)
		)
		(uuid "a1ee84ed-5b4d-4293-b804-da90441edf23")
	)
	(text "1.8 V-powered buffer. Recovering those 8 pins is the rev B fix."
		(exclude_from_sim no)
		(at 20.00 145.50 0)
		(effects
			(font
				(size 1.30 1.30)
			)
			(justify left)
		)
		(uuid "3dbe1de3-5974-4977-93f1-fa8daf94cfb6")
	)
	(text "J4/18 (+5 V from the Tang Nano) left open on purpose: this board is fed"
		(exclude_from_sim no)
		(at 20.00 150.00 0)
		(effects
			(font
				(size 1.30 1.30)
			)
			(justify left)
		)
		(uuid "24d5847b-8daf-4a88-b8f2-978f0237852a")
	)
	(text "from the breadboard rail, so tying both would put two sources on one net."
		(exclude_from_sim no)
		(at 20.00 153.50 0)
		(effects
			(font
				(size 1.30 1.30)
			)
			(justify left)
		)
		(uuid "2f7e873f-7342-4433-8c79-ea33e5fb08cb")
	)
	(text "Power the Tang Nano over USB. +3V3 is taken from J4/24."
