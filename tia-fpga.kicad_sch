				(size 1.30 1.30)
			)
			(justify left)
		)
		(uuid "91f4f5d0-841d-47d9-8158-4cac60c7ca9b")
	)
	(text "from the breadboard rail, so tying both would put two sources on one net."
		(exclude_from_sim no)
		(at 20.00 153.50 0)
		(effects
