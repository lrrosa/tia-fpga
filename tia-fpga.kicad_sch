			)
			(justify left)
		)
		(uuid "0e33f086-670c-4cd0-b12b-ea507face2e9")
	)
	(text "Of the 48 header pins only 29 are usable 3.3 V GPIO: 8 are BANK3 at 1.8 V,"
		(exclude_from_sim no)
		(at 20.00 39.50 0)
		(effects
			(font
				(size 1.40 1.40)
			)
			(justify left)
		)
		(uuid "14a9167a-2a34-4838-a4b8-04d8f952b9ba")
	)
	(text "8 are HDMI differential pairs, 3 are power. Rev A uses all 29, with none spare."
