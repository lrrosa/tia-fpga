	)
	(text "The 7-bit colour value never leaves the FPGA: an internal"
		(exclude_from_sim no)
		(at 228.00 109.50 0)
		(effects
			(font
				(size 1.20 1.20)
			)
			(justify left)
		)
		(uuid "28428b11-bc06-4fda-a6f3-7dc02b4e42a5")
	)
	(text "TMDS encoder drives the HDMI pins, which are dedicated"
		(exclude_from_sim no)
		(at 228.00 112.80 0)
		(effects
			(font
				(size 1.20 1.20)
			)
			(justify left)
		)
		(uuid "d5454c68-91e4-44b4-b6da-2197832be9c1")
	)
	(text "differential pairs on the module and were never part of"
		(exclude_from_sim no)
		(at 228.00 116.10 0)
		(effects
			(font
				(size 1.20 1.20)
			)
			(justify left)
		)
		(uuid "cbc28223-0003-4745-9793-37087ddb4a51")
	)
	(text "the 29-pin GPIO budget. Colour costs zero header pins."
		(exclude_from_sim no)
		(at 228.00 119.40 0)
		(effects
			(font
				(size 1.20 1.20)
			)
			(justify left)
		)
		(uuid "8bcde044-2534-44b4-ad29-63b6fb032ddf")
	)
	(text "FPGA pins (P/N): CK 69/68, D0 71/70, D1 73/72, D2 75/74."
