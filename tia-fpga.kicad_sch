				(size 1.40 1.40)
			)
			(justify left)
		)
		(uuid "ae21b003-e0da-4cae-bab3-b13579ee78d4")
	)
	(text "8 are HDMI differential pairs, 3 are power. Rev A uses all 29, with none spare."
