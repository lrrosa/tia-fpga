	(text "J4/2-9 are BANK3 at 1.8 V - unusable at 3.3 V without a local LDO and a"
		(exclude_from_sim no)
		(at 20.00 142.00 0)
		(effects
			(font
				(size 1.30 1.30)
			)
			(justify left)
		)
		(uuid "243ae25e-78b3-4871-80b2-1f38461191cc")
	)
	(text "1.8 V-powered buffer. Recovering those 8 pins is the rev B fix."
		(exclude_from_sim no)
		(at 20.00 145.50 0)
		(effects
			(font
				(size 1.30 1.30)
			)
			(justify left)
		)
		(uuid "dfdfeb49-2008-42c1-b380-75cb5fcca48a")
	)
	(text "J4/18 (+5 V from the Tang Nano) left open on purpose: this board is fed"
		(exclude_from_sim no)
		(at 20.00 150.00 0)
		(effects
			(font
				(size 1.30 1.30)
			)
			(justify left)
		)
		(uuid "41a06942-8641-4a64-99d7-146ae2fabc02")
	)
	(text "from the breadboard rail, so tying both would put two sources on one net."
		(exclude_from_sim no)
		(at 20.00 153.50 0)
		(effects
			(font
				(size 1.30 1.30)
			)
			(justify left)
		)
		(uuid "9ed1dfdf-5885-47eb-9aec-0f947b964c7b")
	)
	(text "Power the Tang Nano over USB. +3V3 is taken from J4/24."
