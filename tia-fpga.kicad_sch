		)
		(uuid "c1e47c36-b44b-4b6c-9cc8-1e74d63ad162")
	)
	(text "Pin map verified against both Sipeed board revisions (3672 and 3674), which agree."
		(exclude_from_sim no)
		(at 20.00 36.00 0)
		(effects
			(font
				(size 1.40 1.40)
			)
			(justify left)
		)
		(uuid "3b0c436f-6f04-4706-bcd4-f6cc370dc1e6")
	)
	(text "Of the 48 header pins only 29 are usable 3.3 V GPIO: 8 are BANK3 at 1.8 V,"
		(exclude_from_sim no)
		(at 20.00 39.50 0)
		(effects
			(font
				(size 1.40 1.40)
			)
			(justify left)
		)
		(uuid "3b392ca5-f163-48f9-8822-913726a1426b")
	)
	(text "8 are HDMI differential pairs, 3 are power. Rev A uses all 29, with none spare."
		(exclude_from_sim no)
		(at 20.00 43.00 0)
		(effects
