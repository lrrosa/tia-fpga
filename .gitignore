# KiCad
*-backups/
*.kicad_prl
*.kicad_sch-bak
*.kicad_pcb-bak
fp-info-cache
~*

# Generated output
erc*.rpt
drc*.rpt
*.net

# Gowin
impl/
*.gprj.user

# Rendered schematic: the PDF in docs/ is the shareable artefact.
# The SVG is 76k lines and makes every regeneration a huge diff.
*.svg

# KiCad 10's own local-history store: a nested git repo, not ours to publish.
.history/

# Fabrication archive is attached to releases, not tracked
*-gerbers.zip

# Icarus Verilog build products
sim/build/
*.vvp
*.vcd

# Traces recorded from commercial cartridges carry bytes of the game, so they
# stay on the machine that made them. Traces from the project's own test ROMs
# live in sim/traces/ and are committed.
sim/traces/local/
