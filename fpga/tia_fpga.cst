// ============================================================================
// THIS FILE IS DELIBERATELY INCOMPLETE.
// ============================================================================
//
// Every IO_LOC below says TODO. The package pin behind each header pin has to be
// read off the official Sipeed pinout for your board revision:
//
//   https://dl.sipeed.com/shareURL/TANG/Nano%209K/
//   https://wiki.sipeed.com/hardware/en/tang/Tang-Nano-9K/Nano-9K.html
//
// Do not copy numbers from anywhere assuming they are right — fill them in from
// the Sipeed diagram and cross-check against the silkscreen on your own board.
// Getting this wrong with a 5 V 6507 on the other side of the bus can damage the
// FPGA.
//
// Signal names match the net labels in tia-fpga.kicad_sch exactly (FPGA side).
//
// ----------------------------------------------------------------------------
// Package pins that are ALREADY TAKEN on the Tang Nano 9K
// ----------------------------------------------------------------------------
// Extracted from the official board schematic (Tang_nano_9K_3674_schematics.pdf).
// Do not assign these to TIA signals:
//
//   3   BUTTON S1            4   JTAG_SEL / S2
//   10  LED1                 11  LED2           13  LED3
//   14  LED4                 15  LED5           16  LED6
//   17  FPGA_TX              18  FPGA_RX
//   36  TF_SCLK              37  TF_MOSI        38  TF_CS      39  TF_MISO
//   47  SPILCD_EN            48  SPILCD_CS      49  SPILCD_RS
//   52  XTAL_IN (27 MHz)
//   59  MCLK                 60  MCS            61  MOSI       62  MISO  (flash)
//   68-75  HDMI differential pairs
//   76  SPILCD_MCLK          77  SPILCD_MO
//
// JTAG (do not touch): IOL11A/TMS, IOL11B/TCK, IOL12B/TDI, IOL13A/TDO.
//
// Good candidates for general I/O: 19, 20, 25-35, 40-42, 51, 53-57, 63.
// Verify each one against the Sipeed pinout before committing to it.

// ---------------------------------------------------------------- clock
// 3.579545 MHz from the 2600's crystal, via U4 (74LVC541A).
// Do NOT use the board's 27 MHz oscillator for this: 27 MHz cannot produce
// exactly 3.579545 MHz, and the NTSC subcarrier has to be exact.
IO_LOC  "F_OSC" TODO;
IO_PORT "F_OSC" IO_TYPE=LVCMOS33;

// ---------------------------------------------------------------- data bus
// Bidirectional through U2 (74LVC245A).
IO_LOC  "F_D0" TODO;
IO_LOC  "F_D1" TODO;
IO_LOC  "F_D2" TODO;
IO_LOC  "F_D3" TODO;
IO_LOC  "F_D4" TODO;
IO_LOC  "F_D5" TODO;
IO_LOC  "F_D6" TODO;
IO_LOC  "F_D7" TODO;
IO_PORT "F_D0" IO_TYPE=LVCMOS33;
IO_PORT "F_D1" IO_TYPE=LVCMOS33;
IO_PORT "F_D2" IO_TYPE=LVCMOS33;
IO_PORT "F_D3" IO_TYPE=LVCMOS33;
IO_PORT "F_D4" IO_TYPE=LVCMOS33;
IO_PORT "F_D5" IO_TYPE=LVCMOS33;
IO_PORT "F_D6" IO_TYPE=LVCMOS33;
IO_PORT "F_D7" IO_TYPE=LVCMOS33;

// 245 control. DIR=1 => A(TIA) to B(FPGA), i.e. a CPU write.
IO_LOC  "F_DBUS_DIR" TODO;
IO_LOC  "F_DBUS_OE_N" TODO;
IO_PORT "F_DBUS_DIR" IO_TYPE=LVCMOS33;
IO_PORT "F_DBUS_OE_N" IO_TYPE=LVCMOS33;

// ---------------------------------------------------------------- address and select
IO_LOC  "F_A0" TODO;
IO_LOC  "F_A1" TODO;
IO_LOC  "F_A2" TODO;
IO_LOC  "F_A3" TODO;
IO_LOC  "F_A4" TODO;
IO_LOC  "F_A5" TODO;
IO_LOC  "F_CS0_N" TODO;   // <- A12 on the 2600
IO_LOC  "F_CS3_N" TODO;   // <- A7 on the 2600
IO_PORT "F_A0" IO_TYPE=LVCMOS33;
IO_PORT "F_A1" IO_TYPE=LVCMOS33;
IO_PORT "F_A2" IO_TYPE=LVCMOS33;
IO_PORT "F_A3" IO_TYPE=LVCMOS33;
IO_PORT "F_A4" IO_TYPE=LVCMOS33;
IO_PORT "F_A5" IO_TYPE=LVCMOS33;
IO_PORT "F_CS0_N" IO_TYPE=LVCMOS33;
IO_PORT "F_CS3_N" IO_TYPE=LVCMOS33;

// ---------------------------------------------------------------- 6507 handshake
// F_PHI0 leaves through U1 (74AHCT125 at 5 V) — it is the CPU clock, OSC/3.
// F_RDY also goes through U1; this is what WSYNC uses to stall the CPU.
IO_LOC  "F_PHI0" TODO;
IO_LOC  "F_PHI2" TODO;
IO_LOC  "F_RW" TODO;
IO_LOC  "F_RDY" TODO;
IO_PORT "F_PHI0" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "F_PHI2" IO_TYPE=LVCMOS33;
IO_PORT "F_RW" IO_TYPE=LVCMOS33;
IO_PORT "F_RDY" IO_TYPE=LVCMOS33 DRIVE=8;

// ---------------------------------------------------------------- video
// These go straight from the FPGA to the socket pins with no translator: they
// feed the luma resistor network, not logic inputs. 4:2:1 weighting.
IO_LOC  "F_CSYNC" TODO;
IO_LOC  "F_LUM0" TODO;
IO_LOC  "F_LUM1" TODO;
IO_LOC  "F_LUM2" TODO;
IO_LOC  "F_COL" TODO;     // phase 6 — chroma
IO_PORT "F_CSYNC" IO_TYPE=LVCMOS33;
IO_PORT "F_LUM0" IO_TYPE=LVCMOS33;
IO_PORT "F_LUM1" IO_TYPE=LVCMOS33;
IO_PORT "F_LUM2" IO_TYPE=LVCMOS33;
IO_PORT "F_COL" IO_TYPE=LVCMOS33;

// ---------------------------------------------------------------- audio
IO_LOC  "F_AU0" TODO;
IO_LOC  "F_AU1" TODO;
IO_PORT "F_AU0" IO_TYPE=LVCMOS33;
IO_PORT "F_AU1" IO_TYPE=LVCMOS33;

// ---------------------------------------------------------------- controllers
// Triggers, via U4. Pulled up, as on the 2600.
IO_LOC  "F_I4" TODO;
IO_LOC  "F_I5" TODO;
IO_PORT "F_I4" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "F_I5" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Paddles: phase 5. These need an external comparator plus a discharge switch —
// the TIA grounds the capacitor when VBLANK bit 7 is set, then detects the
// threshold crossing. Rev A of the board has no circuit for this.
// IO_LOC  "F_PADDLE_DUMP" TODO;
// IO_LOC  "F_PADDLE_CMP"  TODO;
